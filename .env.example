# Copie para .env (que NÃO vai para o Git) e ajuste se precisar.

# Onde o MLflow guarda runs e o Model Registry. SQLite local = um arquivo mlflow.db na raiz.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Para usar o DagsHub como servidor remoto (MLflow + DVC), troque pelas linhas abaixo:
# MLFLOW_TRACKING_URI=https://dagshub.com/<usuario>/<repositorio>.mlflow
# MLFLOW_TRACKING_USERNAME=<usuario>
# MLFLOW_TRACKING_PASSWORD=<token do DagsHub>
