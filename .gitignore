# ---- Python ----
__pycache__/
*.egg-info/
.venv/
.pytest_cache/

# ---- Projeto ----
# segredos e configurações locais (o modelo é o .env.example)
.env
logs/*.log

# ---- MLflow (rastreio local) ----
mlruns/
mlartifacts/
mlflow.db

# ---- Dados e modelos: versionados pelo DVC, não pelo Git ----
# O Git guarda só os "ponteiros" (dvc.lock e *.dvc, com o hash de cada arquivo);
# o conteúdo fica no cache do DVC. Declarados aqui explicitamente: se um destes entrar no
# Git, o DVC se recusa a versioná-lo ("output is already tracked by SCM").
/data/external/transferencias.zip
/data/raw/*.csv
/data/preprocessed/*.csv
/data/processed/*.csv
/models/*.joblib
logs/*.txt
